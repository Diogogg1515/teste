# CONFIGURAÇÃO PARA TESTES E2E
# Copie este arquivo para tests/.env.test e preencha com projeto Supabase DEDICADO A TESTES

# ⚠️ IMPORTANTE: Use um projeto Supabase SEPARADO para testes
# Não use o mesmo projeto de produção/staging

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO-TESTE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-do-projeto-teste
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-do-projeto-teste

# Para testes de storage cleanup
TEST_STORAGE_BUCKET=service-files